{
  "name": "cs2",
  "display": "Counter Strike 2",
  "type": "srcds",
  "data": {
    "ip": { "type": "string", "desc": "What IP to bind the server to", "display": "IP", "required": true, "value": "0.0.0.0" },
    "port": { "type": "integer", "desc": "What port to bind the server to", "display": "Port", "required": true, "value": 27015 },
    "hostname": { "type": "string", "desc": "Hostname for server.", "display": "Hostname", "required": true, "value": "My CS2 Server" },
    "game_alias": { "type": "string", "desc": "competitive, wingman, casual, deathmatch, custom", "display": "Game Mode", "required": true, "value": "competitive" },
    "map": { "type": "string", "desc": "Fallback map (only used if Workshop Map ID is empty)", "display": "Map", "required": true, "value": "de_mirage" },
    "workshop_map": { "type": "string", "desc": "Steam Workshop map ID to load on startup (e.g. fy_iceworld = 3070238628). Leave empty to use the Map field instead.", "display": "Workshop Map ID", "required": false, "value": "3070238628" },
    "maxplayers": { "type": "integer", "desc": "Maximum number of players on the server", "display": "Maxplayers", "required": true, "value": "64" }
  },
  "install": [
    { "if": "env == 'host'", "type": "steamgamedl", "appId": "730" },
    { "if": "env == 'docker'", "type": "command", "commands": [ "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 730 +quit" ] },
    { "type": "command", "commands": [ "chmod +x ./game/cs2.sh", "chmod +x ./game/bin/linuxsteamrt64/cs2" ] },
    { "type": "command", "commands": [ "mkdir -p /pufferpanel/.steam/sdk64", "ln -sf /pufferpanel/.local/share/Steam/steamcmd/linux64/steamclient.so /pufferpanel/.steam/sdk64/steamclient.so" ] }
  ],
  "run": {
    "stop": "quit",
    "command": "./cs2.sh -dedicated -ip ${ip} -port ${port} -maxplayers ${maxplayers} +hostname \"${hostname}\" +game_alias ${game_alias} +host_workshop_map ${workshop_map}",
    "workingDirectory": "game",
    "pre": [],
    "post": [],
    "environmentVars": {}
  },
  "environment": { "type": "host" },
  "supportedEnvironments": [
    { "type": "host" },
    { "type": "docker", "image": "steamcmd/steamcmd:ubuntu-22", "portBindings": [ "0.0.0.0:${port}:${port}/tcp", "0.0.0.0:${port}:${port}/udp" ] }
  ],
  "requirements": { "os": "linux", "arch": "amd64" }
}
